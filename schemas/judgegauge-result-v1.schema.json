{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/DaBestCode/JudgeGauge/main/schemas/judgegauge-result-v1.schema.json",
  "title": "JudgeGauge Calibration Result",
  "description": "Schema for JudgeGauge calibration results. Unknown additive fields remain allowed within version 1. A breaking field removal or semantic change requires a new schema version.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "verdict": {
      "type": "string",
      "enum": ["pass", "fail"]
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "value": { "type": "number" },
          "threshold": { "type": "number" },
          "comparator": { "type": "string" },
          "passed": { "type": "boolean" },
          "detail": { "type": "string" }
        },
        "required": ["name", "value", "threshold", "comparator", "passed"]
      }
    },
    "request_count": { "type": "integer", "minimum": 0 },
    "valid_readouts": { "type": "integer", "minimum": 0 },
    "invalid_readouts": { "type": "integer", "minimum": 0 },
    "requested_model": { "type": "string" },
    "response_models": {
      "type": "array",
      "items": { "type": "string" }
    },
    "snapshot_level": { "type": "string" },
    "suite": { "type": "string" },
    "limitations": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "required": [
    "schema_version",
    "verdict",
    "metrics",
    "request_count",
    "valid_readouts",
    "invalid_readouts",
    "requested_model",
    "response_models",
    "snapshot_level",
    "suite",
    "limitations"
  ],
  "additionalProperties": true
}
